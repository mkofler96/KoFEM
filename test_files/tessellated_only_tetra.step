ISO-10303-21;
HEADER;
/* A tetrahedron stored only as a tessellated mesh: an AP242
   COMPLEX_TRIANGULATED_FACE in a TESSELLATED_SHELL, with no BRep solid or
   face. Some CAD exporters write STEP files like this; KoFEM must refuse them
   with a clear error (KOF-361). Hand-written test fixture. */
FILE_DESCRIPTION(('KoFEM test fixture: tessellated-only STEP'),'2;1');
FILE_NAME('tessellated_only_tetra.step','2026-11-14T00:00:00',(''),(''),
'KoFEM','KoFEM','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 3 1 4 }'));
ENDSEC;
DATA;
#10=SHAPE_REPRESENTATION_RELATIONSHIP('','',#31,#11);
#11=TESSELLATED_SHAPE_REPRESENTATION('',(#29),#37);
#27=COMPLEX_TRIANGULATED_FACE('Tetra',#28,4,((0.,0.,-1.),(0.,-1.,0.),
(-1.,0.,0.),(0.577,0.577,0.577)),$,(1,2,3,4),((1,3,2),(1,2,4),(1,4,3),
(2,3,4)),());
#28=COORDINATES_LIST('',4,((0.,0.,0.),(10.,0.,0.),(0.,10.,0.),
(0.,0.,10.)));
#29=TESSELLATED_SHELL('Tetra',(#27),$);
#30=SHAPE_DEFINITION_REPRESENTATION(#42,#31);
#31=SHAPE_REPRESENTATION('Tetra',(#32),#37);
#32=AXIS2_PLACEMENT_3D('',#35,#33,#34);
#33=DIRECTION('',(0.,0.,1.));
#34=DIRECTION('',(1.,0.,0.));
#35=CARTESIAN_POINT('',(0.,0.,0.));
#37=(
GEOMETRIC_REPRESENTATION_CONTEXT(3)
GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#38))
GLOBAL_UNIT_ASSIGNED_CONTEXT((#41,#40,#39))
REPRESENTATION_CONTEXT('Tetra','TOP_LEVEL_ASSEMBLY_PART')
);
#38=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-5),#41,
'DISTANCE_ACCURACY_VALUE','Maximum Tolerance applied to model');
#39=(
NAMED_UNIT(*)
SI_UNIT($,.STERADIAN.)
SOLID_ANGLE_UNIT()
);
#40=(
NAMED_UNIT(*)
PLANE_ANGLE_UNIT()
SI_UNIT($,.RADIAN.)
);
#41=(
LENGTH_UNIT()
NAMED_UNIT(*)
SI_UNIT(.MILLI.,.METRE.)
);
#42=PRODUCT_DEFINITION_SHAPE('','',#43);
#43=PRODUCT_DEFINITION('','',#45,#44);
#44=PRODUCT_DEFINITION_CONTEXT('',#51,'design');
#45=PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE('','',#47,
 .NOT_KNOWN.);
#47=PRODUCT('Tetra','Tetra','Tetra',(#49));
#49=PRODUCT_CONTEXT('',#51,'mechanical');
#50=APPLICATION_PROTOCOL_DEFINITION('international standard',
'ap242_managed_model_based_3d_engineering',2020,#51);
#51=APPLICATION_CONTEXT('managed model based 3d engineering');
ENDSEC;
END-ISO-10303-21;
