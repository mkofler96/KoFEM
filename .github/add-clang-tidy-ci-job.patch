diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 9a8eba4..39baa85 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -37,6 +37,40 @@ jobs:
       - name: Tests
         run: cargo test --workspace
 
+  clang-tidy:
+    name: C++ clang-tidy
+    runs-on: ubuntu-24.04
+
+    steps:
+      - uses: actions/checkout@v4
+
+      # fetch-wasm-deps.sh writes to /emsdk and /opt/kofem-deps (the image's
+      # baked-in paths); pre-own them so the non-root fetch and the cache
+      # restore/save can both write there.
+      - name: Prepare toolchain dirs
+        run: sudo mkdir -p /emsdk /opt/kofem-deps && sudo chown -R "$USER" /emsdk /opt/kofem-deps
+
+      - name: Cache WASM toolchain
+        uses: actions/cache@v4
+        with:
+          path: |
+            /emsdk
+            /opt/kofem-deps
+          key: wasm-toolchain-${{ runner.os }}-deps0.0.2
+
+      # Idempotent: exits immediately on a cache hit (checks .kofem-deps-tag).
+      - name: Fetch WASM deps
+        run: bash scripts/fetch-wasm-deps.sh
+
+      # clang-tidy >= 20 is required to parse the emsdk clang-22-era headers;
+      # ninja-build is needed by the emcmake configure that emits
+      # compile_commands.json (see scripts/clang-tidy.sh).
+      - name: Install clang-tidy-20
+        run: sudo apt-get update && sudo apt-get install -y clang-tidy-20 ninja-build
+
+      - name: clang-tidy
+        run: bash scripts/clang-tidy.sh
+
   wasm:
     name: WASM (Emscripten)
     runs-on: ubuntu-24.04
