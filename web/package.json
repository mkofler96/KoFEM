{
  "name": "kofem-web",
  "version": "0.6.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "wasm:fetch": "bash scripts/ensure-wasm-engine.sh",
    "wasm:fem": "bash scripts/ensure-fem-wasm.sh",
    "wasm:prepare": "bun run wasm:fetch && bun run wasm:fem",
    "predev": "bun run wasm:prepare",
    "dev": "vite",
    "prebuild": "bun run wasm:prepare",
    "build": "tsc && vite build",
    "prebuild:dev": "bun run wasm:prepare",
    "build:dev": "tsc && vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests eslint-rules",
    "format": "prettier --write src tests eslint-rules eslint.config.js playwright.config.ts playwright.capture.config.ts playwright.docker.config.ts \"../*.md\" \"../.github/**/*.md\"",
    "format:check": "prettier --check src tests eslint-rules eslint.config.js playwright.config.ts playwright.capture.config.ts playwright.docker.config.ts \"../*.md\" \"../.github/**/*.md\"",
    "prevalidate": "bun run wasm:prepare",
    "validate": "bun ../examples/validation/run.mjs",
    "prevalidate:report": "bun run wasm:prepare",
    "validate:report": "bun ../examples/validation/run.mjs --report",
    "validate:pages": "bun ../examples/validation/run.mjs --pages",
    "examples:generate-crane-shell": "bun ../examples/unvalidated/crane-hook/generate-crane-shell.mjs",
    "examples:generate-mbb-topopt": "bun ../examples/gallery/generate-mbb-topopt.mjs",
    "coverage:report": "nyc report && bun scripts/coverage-dead-code.ts",
    "capture:tutorial": "playwright test -c playwright.capture.config.ts tutorial-capture.spec.ts",
    "capture:readme": "playwright test -c playwright.capture.config.ts example-load.spec.ts",
    "capture:og": "playwright test -c playwright.capture.config.ts og-image-capture.spec.ts",
    "theory:generate": "bun theory/generate.mjs"
  },
  "packageManager": "bun",
  "dependencies": {
    "@react-three/drei": "^9.115.0",
    "@react-three/fiber": "^8.17.0",
    "immer": "^10.1.1",
    "jspdf": "^4.2.1",
    "leva": "^0.9.35",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.18.0",
    "three": "^0.167.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.167.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.0",
    "nyc": "^18.0.0",
    "prettier": "^3.6.0",
    "subset-font": "2.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^5.4.0",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plugin-top-level-await": "^1.4.0",
    "vite-plugin-wasm": "^3.3.0"
  }
}
