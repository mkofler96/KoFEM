# Rendered by the nginx image entrypoint (envsubst) at container start.
# Only env vars present in the environment are substituted, so nginx
# runtime variables like $uri are left untouched — $PORT is filled in.
server {
    listen       ${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # nginx:alpine's mime.types already maps .wasm -> application/wasm.
    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;
    # Responses differ by Accept-Encoding; say so to caches in front (a CDN).
    gzip_vary on;

    # Fingerprinted Vite assets are immutable — cache them aggressively.
    location /assets/ {
        # The Dockerfile precompresses them at gzip -9 (KOF-263): the engine's
        # .wasm travels as 9.0 MB instead of the 10.7 MB nginx's on-the-fly
        # level-1 gzip makes of it, and is not recompressed on every request.
        gzip_static on;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Vite source URLs are dev-only. In production they should not be masked by
    # the HTML fallback, otherwise a stale /src/main.tsx request gets a 200 HTML
    # response and hides the real deployment issue.
    location /src/ {
        return 404;
    }

    # The React solver is mounted below /app/. Deep links under that prefix must
    # serve the app entry; the marketing landing page remains the root fallback.
    location /app/ {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /app/index.html;
    }

    # Static marketing landing fallback. Its /landing/ files keep their names
    # across deploys, and each .json describes the layout of its .bin. Without
    # revalidation a browser can pair a cached .json with a newer .bin.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
