#!/usr/bin/env bash
set -euo pipefail

echo "▶ cargo fmt check…"
cargo fmt --all --check

echo "▶ cargo clippy…"
cargo clippy --all-targets --all-features -- -D warnings

# Web checks only when the commit touches what they cover — Rust-only commits
# stay fast. Prettier also owns the repo's markdown (DeepSource enforces it
# repo-wide, so the hook must match or its autofix bot reformats after merge).
STAGED="$(git diff --cached --name-only)"

if echo "$STAGED" | grep -qE '^web/|\.md$'; then
    if [ ! -d web/node_modules ]; then
        echo "✗ commit needs the web toolchain but web/node_modules is missing — run: cd web && bun install" >&2
        exit 1
    fi
    echo "▶ prettier check…"
    (cd web && bun run format:check)
fi

if echo "$STAGED" | grep -q '^web/'; then
    echo "▶ eslint…"
    (cd web && bun run lint)

    echo "▶ tsc typecheck…"
    (cd web && bun run typecheck)
fi

# C++ engine lint — mirrors the DeepSource rules (see .clang-tidy) the same way
# eslint mirrors them for web/. Uses the local Emscripten SDK when present;
# machines that build the engine through Docker run the same check in the
# kofem-dependencies image instead.
if echo "$STAGED" | grep -q '^engine/'; then
    if [ -d "${EMSDK:-/emsdk}/upstream/emscripten/cache/sysroot" ]; then
        echo "▶ clang-tidy…"
        bash scripts/clang-tidy.sh
    elif command -v docker >/dev/null && docker info >/dev/null 2>&1; then
        echo "▶ clang-tidy (in Docker — no local Emscripten SDK)…"
        bash scripts/docker-clang-tidy.sh
    else
        echo "✗ commit touches engine/ but clang-tidy cannot run: no Emscripten SDK at ${EMSDK:-/emsdk} and no running Docker daemon." >&2
        echo "  Start Docker (runs scripts/docker-clang-tidy.sh), or install the local toolchain: bash scripts/fetch-wasm-deps.sh and clang-tidy >= 20." >&2
        exit 1
    fi
fi

echo "✓ pre-commit checks passed"
