#!/usr/bin/env bash
set -euo pipefail

echo "▶ cargo fmt check…"
cargo fmt --all --check

echo "▶ cargo clippy…"
cargo clippy --all-targets --all-features -- -D warnings

# Web checks only when the commit touches web/ — Rust-only commits stay fast.
if ! git diff --cached --quiet -- web; then
    if [ ! -d web/node_modules ]; then
        echo "✗ commit touches web/ but web/node_modules is missing — run: cd web && bun install" >&2
        exit 1
    fi
    echo "▶ prettier check…"
    (cd web && bun run format:check)

    echo "▶ eslint…"
    (cd web && bun run lint)

    echo "▶ tsc typecheck…"
    (cd web && bun run typecheck)
fi

echo "✓ pre-commit checks passed"
