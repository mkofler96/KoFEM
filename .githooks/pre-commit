#!/usr/bin/env bash
set -euo pipefail

echo "▶ cargo fmt check…"
cargo fmt --all --check

echo "▶ cargo clippy…"
cargo clippy --all-targets --all-features -- -D warnings

# Web checks only when the commit touches what they cover — Rust-only commits
# stay fast. Prettier also owns the repo's markdown (DeepSource enforces it
# repo-wide, so the hook must match or its autofix bot reformats after merge).
STAGED="$(git diff --cached --name-only)"

if echo "$STAGED" | grep -qE '^web/|\.md$'; then
    if [ ! -d web/node_modules ]; then
        echo "✗ commit needs the web toolchain but web/node_modules is missing — run: cd web && bun install" >&2
        exit 1
    fi
    echo "▶ prettier check…"
    (cd web && bun run format:check)
fi

if echo "$STAGED" | grep -q '^web/'; then
    echo "▶ eslint…"
    (cd web && bun run lint)

    echo "▶ tsc typecheck…"
    (cd web && bun run typecheck)
fi

# C++ engine lint — mirrors the DeepSource rules (see .clang-tidy) the same way
# eslint mirrors them for web/. Anyone editing engine/ needs the WASM toolchain
# to compile anyway, so requiring it here matches the web/node_modules check.
if echo "$STAGED" | grep -q '^engine/'; then
    echo "▶ clang-tidy…"
    bash scripts/clang-tidy.sh
fi

echo "✓ pre-commit checks passed"
